# Copy to .env and fill in. Only public-prefixed vars (EXPO_PUBLIC_*, NEXT_PUBLIC_*) may reach app code.
# Server secret keys stay server-only and never get a public prefix.

# Local dev: values from `npx supabase status` (local stack). Production values live in Vercel only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tests only (RLS checks, e2e admin sign-in). LOCAL stack secret key; never the prod key, never used in src/.
SUPABASE_SECRET_KEY=
